# deploy/ec2/docker-compose.yml（EC2上のPostgreSQL）が読み込む環境変数のひな形。
# 必要な変数名を共有するためのファイルなので、値は入れずにコミットしている。
#
# 本物の値はリポジトリに入れず、EC2上でこのディレクトリの .env に書くか、環境変数として渡して起動する。
# .env はGitの管理対象から除外している（本物の認証情報を誤ってコミットしないため）。
#
# 空のままでは起動しない（docker-compose.yml で必須にしているため）。

# データベース名
POSTGRES_DB=
# DBユーザー名
POSTGRES_USER=
# DBユーザーのパスワード
POSTGRES_PASSWORD=
