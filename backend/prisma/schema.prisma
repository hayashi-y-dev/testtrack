// =============================================================================
// TestTrack Prismaスキーマ
// =============================================================================
// 設計判断の詳細は同ファイルの3章を参照

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// Enum定義
// =============================================================================

enum ProjectStatus {
  active
  archived
}

enum ProjectRole {
  admin
  tester
  viewer
}

// =============================================================================
// テーブル定義
// =============================================================================

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")  // 姓・名を分けて使う機能（並べ替え・敬称付けなど）がないため、1つの項目にしている
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projectMembers      ProjectMember[]
  testFilesUpdated    TestFile[]            @relation("TestFileUpdatedBy")
  progressSnapshots   ProgressSnapshot[]    @relation("SnapshotUpdatedBy")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// Project
// -----------------------------------------------------------------------------
model Project {
  id        String        @id @default(uuid())
  name      String        // 1〜50文字、前後空白除去はAPI側でバリデーション
  status    ProjectStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  members   ProjectMember[]
  testFiles TestFile[]

  @@map("projects")
}

// -----------------------------------------------------------------------------
// ProjectMember
// -----------------------------------------------------------------------------
// どのユーザーが、どのプロジェクトに、どのロールで参加しているかを管理
model ProjectMember {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  projectId    String      @map("project_id")
  role         ProjectRole
  displayOrder Int?        @map("display_order") // タブ表示順。archivedプロジェクトはNULL
  createdAt    DateTime    @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 1ユーザー1プロジェクト1ロールの制約
  @@unique([userId, projectId])
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// TestFile
// -----------------------------------------------------------------------------
// Excelから読み込んだテストファイルの情報と最新の集計値を保持
// 最新の集計値は本体に直接持たせる。一覧・進捗集計の取得が結合なしで済み、楽観ロック（version）と集計値の更新を同じ行で行えるため
model TestFile {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  name          String   // ファイル名
  targetCount   Int      @map("target_count")   // 対象テストケース数
  okCount       Int      @map("ok_count")
  ngCount       Int      @map("ng_count")
  notRunCount   Int      @map("not_run_count")  // 未実施件数
  excludedCount Int      @map("excluded_count") // 対象外件数（「-」）
  version       Int      @default(1)            // 楽観ロック用
  lastUpdatedBy String   @map("last_updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("TestFileUpdatedBy", fields: [lastUpdatedBy], references: [id], onDelete: Restrict)
  // lastUpdatedByのonDelete: Restrict
  // 現MVP仕様にユーザー削除機能がないため、将来追加時に再検討

  snapshots ProgressSnapshot[]

  // 同一プロジェクト内でファイル名は一意
  @@unique([projectId, name])
  @@map("test_files")
}

// -----------------------------------------------------------------------------
// ProgressSnapshot
// -----------------------------------------------------------------------------
// テストファイルの進捗履歴。登録取消できるか（初回登録の履歴しかないか）の判定と、いつ・誰が更新したかの記録に使う
// - 登録取消可否判定（初回登録後の更新履歴有無）
// - 将来の日別進捗推移グラフ（MVP対象外）
// - 監査ログ的な記録
model ProgressSnapshot {
  id            String   @id @default(uuid())
  testFileId    String   @map("test_file_id")
  targetCount   Int      @map("target_count")
  okCount       Int      @map("ok_count")
  ngCount       Int      @map("ng_count")
  notRunCount   Int      @map("not_run_count")
  excludedCount Int      @map("excluded_count")
  updatedBy     String   @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")

  testFile TestFile @relation(fields: [testFileId], references: [id], onDelete: Cascade)
  user     User     @relation("SnapshotUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("progress_snapshots")
}

// -----------------------------------------------------------------------------
// Session（セッション管理用・connect-pg-simple互換）
// -----------------------------------------------------------------------------
// connect-pg-simpleが期待するカラム構造に合わせた定義
// アプリケーションコードからは直接操作せず、express-session経由で管理される
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
  @@map("session")
}

// -----------------------------------------------------------------------------
// PasswordResetToken
// -----------------------------------------------------------------------------
// パスワード再設定用トークン。一時的な使い捨ての情報をユーザー本体に混ぜないため、専用テーブルにしている
// tokenカラムにはSHA-256ハッシュ化した値を保存する（生トークンは保存しない）
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
