# backend（NestJS）が読み込む環境変数のひな形。
# このファイルをコピーして同じディレクトリに .env を作り、値を書き換えて使う。
# 値はすべて説明用のダミー。.env はGitの管理対象から除外している（本物の認証情報を誤ってコミットしないため）。
#
# AWSの認証情報（アクセスキー等）はここにも .env にも書かない。本番ではEC2のIAMロールを使う。

# PostgreSQLの接続先（必須）。下の値は手元の開発用DB（backend/docker-compose.yml）に合わせたもの
DATABASE_URL=postgresql://testtrack:testtrack@localhost:5432/testtrack

# セッションCookieの署名に使う秘密の文字列（必須）。推測されにくい長いランダム文字列にする
# 例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" で生成する
SESSION_SECRET=change-me-to-a-long-random-string

# 実行モード（省略可）。production のとき、セッションCookieのsecure化とSESでのメール送信が有効になる。
# HTTPSで公開する環境でのみ production にする（HTTPのままだとCookieが保存されず、ログインできなくなるため）
NODE_ENV=development

# APIサーバーの待ち受けポート（省略可。省略時は3001）
PORT=3001

# フロントエンドのURL（省略可。省略時は http://localhost:3000）。パスワード再設定URLの組み立てに使う
FRONTEND_URL=http://localhost:3000

# パスワード再設定メールの送信元アドレス。本番モード（NODE_ENV=production）のメール送信でのみ使う。
# SESで検証済みのアドレスを指定する。未設定の場合、メールは送られずサーバーログにエラーが残る
SES_FROM_ADDRESS=noreply@example.com

# デモ用アカウント（Seedで作る5人）のパスワード。15文字以上64文字以下。
# 本番モード（NODE_ENV=production）では必須で、開発用のパスワード（リポジトリで公開されている値）は使えない。
# 開発では省略でき、省略すると開発用のパスワードになる
DEMO_USER_PASSWORD=
